# Chọn MỘT dòng, xóa dấu # ở đầu dòng đó, rồi dán khóa thật vào sau dấu bằng.
# Không gửi file này cho người khác.

# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-3.8-flash

# Mã trang web lấy ở Google Cloud, mục OAuth client, loại Web application.
# GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com

# Cuốn sổ ở Turso. Để trống hai dòng này thì máy nhà vẫn dùng file du_lieu/tuvilaso.db.
# TURSO_DATABASE_URL=libsql://....turso.io
# TURSO_AUTH_TOKEN=...
